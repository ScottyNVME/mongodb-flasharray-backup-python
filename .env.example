# Pure Storage FlashArray
FA_ENDPOINT=<array-hostname-or-ip>
FA_USERNAME=<array-username>
# Authentication (direct REST). Two options:
#   * FA_USERNAME + FA_PASSWORD  -> directory login; authorizes on EVERY fleet member (recommended,
#                                   matches the PowerShell -Credential behavior).
#   * FA_APITOKEN                -> a FlashArray API token; only valid on the array that issued it.
# username/password is preferred when both are set. At least one option must be provided.
FA_APITOKEN=<array-api-token>
# FA_PASSWORD=<array-login-password>   # optional; enables directory login for fleet-wide access
# FA REST API version to pin (skips client version auto-negotiation).
# Match the api/<version> your array exposes (e.g. 2.51).
FA_API_VERSION=2.51
FA_PROTECTION_GROUP=<pg-name>
FA_CLUSTER_NAME=<cluster-name>

# Ops Manager
# OM_BASE_URL is the host+port only; the API path and version are added by Config.ps1.
OM_BASE_URL=http://<ops-manager-host>:8080
# Ops Manager public API version to pin to. Change only when intentionally upgrading.
OM_API_VERSION=v1.0
OM_GROUP_ID=<group-id>
OM_CLUSTER_ID=<cluster-id>
OM_PUBLIC_KEY=<om-api-public-key>
OM_PRIVATE_KEY=<om-api-private-key>

# MongoDB cluster
MONGOS_HOST=<mongos-hostname>
MONGOS_PORT=27017
SSH_USER=<ssh-username>
# CLUSTER_NODES is optional - used as fallback when Ops Manager is unreachable.
# If omitted, node discovery will fail if OM is unavailable.
# CLUSTER_NODES=<node-1>,<node-2>,<node-3>
MONGOSH_PATH=<path-to-mongosh>
MONGO_TOOLS_BASE=<path-to-mongo-database-tools>
